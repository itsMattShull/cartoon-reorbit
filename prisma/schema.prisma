  czoneContestDiscordChannelId   String?
  devPrDiscordChannelId          String? // posts PR opened/merged notices for the dev branch
  prodPrDiscordChannelId         String? // posts PR opened/merged notices for the master branch
  // Scavenger Hunt settings
