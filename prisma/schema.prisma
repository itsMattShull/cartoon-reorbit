// ── ReOrbit Memory ─────────────────────────────────────────────────────────────
// `moves` is the number of pairs attempted to complete the board — LOWER is better,
// unlike every other game's `score` field. The leaderboard sorts this column ascending.

model ReOrbitMemoryScore {
  id        String   @id @default(uuid())
  userId    String
  moves     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, moves])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ReOrbitMemoryPlay {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ── Guess that cToon! ──────────────────────────────────────────────────────────
// `streak` is the number of consecutive correct answers in one run — higher is
// better. `suspicious` marks runs whose answer cadence is too machine-regular or
// too fast to be human (see scoreCadence in guessCtoonEngine); those rows are kept
// for auditing but filtered out of the leaderboard rather than deleted, so a false
// positive costs a player their leaderboard slot and nothing else.

model GuessCtoonScore {
  id             String   @id @default(uuid())
  userId         String
  streak         Int
  // False for runs played past the daily scored-play cap: kept so a player can see their
  // practice history, but excluded from the leaderboard and never worth points.
  counted        Boolean  @default(true)
  suspicious     Boolean  @default(false)
  medianAnswerMs Int?
  stdDevAnswerMs Int?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, streak])
  // Covering index: the weekly/monthly leaderboards filter on createdAt and then
  // only need userId + streak, so they run index-only with no heap access.
  @@index([createdAt, userId, streak])
  @@index([userId, counted, streak])
}

model GuessCtoonPlay {
  id        String   @id @default(uuid())
  userId    String
  // Decided at /start under an advisory lock, so the player knows before answering whether
  // the run will count.
  counted   Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, counted, createdAt])
}

// ── Flappy Powerpuff ───────────────────────────────────────────────────────────

model FlappyPowerpuffScore {
  id        String   @id @default(uuid())
  userId    String
  score     Int
  character String // blossom | bubbles | buttercup — cosmetic only, never affects physics
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, score])
  @@index([createdAt, userId, score]) // covering: leaderboard period filters + the global week high
}

// Unlike every other game, Flappy allows unlimited play once the daily ranked allotment is
// spent. Those runs are still recorded with ranked=false so the game stays visible to play
// analytics and to the activity signals that feed dormancy — only ranked=true rows count
// against the allotment. Mirrors the TkoRound.counted precedent.
model FlappyPowerpuffPlay {
  id        String   @id @default(uuid())
  userId    String
  ranked    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, ranked, createdAt])
}

// ── Fruit Samurai ──────────────────────────────────────────────────────────────
// Higher `score` is better. Runs past the daily ranked allotment are not stored at all —
// unlike Flappy, which keeps unranked rows, there is nothing to learn from a practice run
// here that the play row below doesn't already record.

model FruitSamuraiScore {
  id        String   @id @default(uuid())
  userId    String
  score     Int
  // Ticks survived. Kept alongside the score because the two together are the honest
  // anomaly signal — a huge score in very few ticks is the shape worth looking at.
  ticks     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, score])
  @@index([createdAt, userId, score]) // covering: leaderboard period filters + the week high
}

// Mirrors FlappyPowerpuffPlay: unlimited practice once the daily ranked allotment is spent,
// with unranked runs still recorded so the game stays visible to play analytics and to the
// activity signals that feed dormancy. Only ranked=true rows count against the allotment.
model FruitSamuraiPlay {
  id        String   @id @default(uuid())
  userId    String
  ranked    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, ranked, createdAt])
}

// ── VPN Detection ─────────────────────────────────────────────────────────────

model VpnLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  ip          String
  detectedAt  DateTime @default(now())
  isVpn       Boolean
  proxyType   String?
  isp         String?
  org         String?
  asn         String?
  country     String?
  countryCode String?
  reason      String?

  @@index([userId])
  @@index([ip])
  @@index([detectedAt])
}

// ── Operation A.S.T.E.R.O.I.D. ─────────────────────────────────────────────────
// Unlike every other game here, plays are UNLIMITED — only the first
// `asteroidRankedPlaysPerPeriod` runs of each daily window are "ranked". A row is written to
// AsteroidPlay only when a ranked slot is consumed (at /start, inside the per-user lock), and
// a row is written to AsteroidScore only when a ranked run ends. Unranked practice runs
// intentionally leave no trace, which is what keeps unlimited play from growing these tables
// without bound.

model AsteroidScore {
  id        String   @id @default(uuid())
  userId    String
  score     Int
  wave      Int      @default(1)
  ticks     Int      @default(0)
  // Which ship flew this run, for balance analysis across the three weapon profiles.
  shipId    String   @default("casual")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, score])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model AsteroidPlay {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ── ReOrbit Blackjack ─────────────────────────────────────────────────────────
//
// The only durable table this game needs. It holds MONEY state and nothing else: the live
// hand — the shuffled cards, the dealer's hole card, whose turn it is — lives in Redis under
// server/utils/blackjackRuntime.js and is rebuilt from scratch if it is ever lost.
//
// That split is deliberate on both axes:
//
//  * Nothing secret is stored here, so no careless `findUnique` on this model can leak the
//    hole card or the undealt cards. There is no column to forget to strip.
//  * A row is written once per hand and once per money movement, not once per tap. Blackjack
//    is a per-interaction game like Guess that cToon (see server/utils/hotPaths.js), and a
//    jsonb shoe rewritten on every hit would re-TOAST several KB per click.
//
// There is deliberately NO per-hand table. AsteroidPlay's comment in this file explains the
// principle — rows that nothing queries must not be allowed to grow without bound — and
// blackjack is the only game here with no cap on hands played, so a row per hand would make it
// the largest table in the schema to serve no query. Per-day totals are aggregated from these
// session rows, and money is audited through PointsLog.
enum BlackjackMode {
  practice
  gamble
}

model BlackjackSession {
  id     String        @id @default(uuid())
  userId String
  mode   BlackjackMode
  status String        @default("active") // active | cashed_out | closed

  // Chips NOT at risk. A wager is moved out of `chips` and into `wagered` the moment it is
  // placed, so the same chip is never simultaneously in the stack and on the felt — which is
  // what stops a cash-out fired mid-hand from banking money that is already in play.
  chips   Int @default(0)
  wagered Int @default(0)

  totalBuyIn Int @default(0) // points converted to chips over this session's life
  cashedOut  Int @default(0) // chips converted back to points

  // 'live' while a hand is in progress. Cash-out requires 'idle', enforced in the WHERE clause
  // of the conditional UPDATE rather than by reading and then deciding.
  handPhase String @default("idle")

  // Optimistic-concurrency counter. Every mutation is an UPDATE ... WHERE version = $expected
  // whose row count is checked, so a double-submitted action loses instead of applying twice.
  version Int @default(0)

  // Set to "<userId>:<mode>" while active and NULL once closed. The unique constraint is what
  // makes "two tabs, two bankrolls" impossible at the database level instead of relying on an
  // expiring Redis lock. Prisma cannot express a partial unique index, so this sentinel column
  // is the portable form of `UNIQUE (userId) WHERE status = 'active'`.
  activeKey String? @unique

  // Config frozen at buy-in, so an admin editing limits mid-session cannot change the terms of
  // a session already holding a player's points.
  rules Json

  // The 8pm-CST daily window this session belongs to. A session found with an older window is
  // settled on the next request — see settleStaleSessions() — which is how abandoned chips get
  // returned without depending on a cron process being deployed.
  windowStart DateTime

  lastActionAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  // Daily buy-in and net-winnings totals are aggregated over this index.
  @@index([userId, createdAt])
  // Serves the stale-session sweeper, which filters on status alone.
  @@index([status, windowStart])
}
