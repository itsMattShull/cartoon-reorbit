// ── Ban/Unban auditing ─────────────────────────────────────────────

enum BanAction {
  BAN
  UNBAN
  DISSOLVE
}

model UserBanNote {
  id        String    @id @default(uuid())
  userId    String
  adminId   String
  action    BanAction
  reason    String
  createdAt DateTime  @default(now())

