// ── Operation A.S.T.E.R.O.I.D. ─────────────────────────────────────────────────
// Unlike every other game here, plays are UNLIMITED — only the first
// `asteroidRankedPlaysPerPeriod` runs of each daily window are "ranked". A row is written to
// AsteroidPlay only when a ranked slot is consumed (at /start, inside the per-user lock), and
// a row is written to AsteroidScore only when a ranked run ends. Unranked practice runs
// intentionally leave no trace, which is what keeps unlimited play from growing these tables
// without bound.

model AsteroidScore {
  id        String   @id @default(uuid())
  userId    String
  score     Int
  wave      Int      @default(1)
  ticks     Int      @default(0)
  // Which ship flew this run, for balance analysis across the three weapon profiles.
  shipId    String   @default("casual")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, score])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model AsteroidPlay {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ── ReOrbit Blackjack ─────────────────────────────────────────────────────────
//
// The only durable table this game needs. It holds MONEY state and nothing else: the live
// hand — the shuffled cards, the dealer's hole card, whose turn it is — lives in Redis under
// server/utils/blackjackRuntime.js and is rebuilt from scratch if it is ever lost.
//
// That split is deliberate on both axes:
//
//  * Nothing secret is stored here, so no careless `findUnique` on this model can leak the
//    hole card or the undealt cards. There is no column to forget to strip.
//  * A row is written once per hand and once per money movement, not once per tap. Blackjack
//    is a per-interaction game like Guess that cToon (see server/utils/hotPaths.js), and a
//    jsonb shoe rewritten on every hit would re-TOAST several KB per click.
//
// There is deliberately NO per-hand table. AsteroidPlay's comment in this file explains the
// principle — rows that nothing queries must not be allowed to grow without bound — and
// blackjack is the only game here with no cap on hands played, so a row per hand would make it
// the largest table in the schema to serve no query. Per-day totals are aggregated from these
// session rows, and money is audited through PointsLog.
enum BlackjackMode {
  practice
  gamble
}

model BlackjackSession {
  id     String        @id @default(uuid())
  userId String
  mode   BlackjackMode
  status String        @default("active") // active | cashed_out | closed

  // Chips NOT at risk. A wager is moved out of `chips` and into `wagered` the moment it is
  // placed, so the same chip is never simultaneously in the stack and on the felt — which is
  // what stops a cash-out fired mid-hand from banking money that is already in play.
  chips   Int @default(0)
  wagered Int @default(0)

  totalBuyIn Int @default(0) // points converted to chips over this session's life
  cashedOut  Int @default(0) // chips converted back to points

  // 'live' while a hand is in progress. Cash-out requires 'idle', enforced in the WHERE clause
  // of the conditional UPDATE rather than by reading and then deciding.
  handPhase String @default("idle")

  // Optimistic-concurrency counter. Every mutation is an UPDATE ... WHERE version = $expected
  // whose row count is checked, so a double-submitted action loses instead of applying twice.
  version Int @default(0)

  // Set to "<userId>:<mode>" while active and NULL once closed. The unique constraint is what
  // makes "two tabs, two bankrolls" impossible at the database level instead of relying on an
  // expiring Redis lock. Prisma cannot express a partial unique index, so this sentinel column
  // is the portable form of `UNIQUE (userId) WHERE status = 'active'`.
  activeKey String? @unique

  // Config frozen at buy-in, so an admin editing limits mid-session cannot change the terms of
  // a session already holding a player's points.
  rules Json

  // The 8pm-CST daily window this session belongs to. A session found with an older window is
  // settled on the next request — see settleStaleSessions() — which is how abandoned chips get
  // returned without depending on a cron process being deployed.
  windowStart DateTime

  lastActionAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  // Daily buy-in and net-winnings totals are aggregated over this index.
  @@index([userId, createdAt])
  // Serves the stale-session sweeper, which filters on status alone.
  @@index([status, windowStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// cZone Mail ("cMail")
//
// Players leave pre-made, admin-authored messages on each other's cZones. Free
// text is deliberately impossible: the send endpoint only accepts a template id
// and snapshots that template's text server-side.

/// One admin-authored canned sentence, offered in the send dropdown.
model CZoneMailTemplate {
  id        String  @id @default(uuid())
  text      String
  emoji     String?
  /// Groups templates into optgroup-style sections in the picker.
  category  String?
  sortOrder Int     @default(0)
  /// Soft-disable. Templates are never hard-deleted from the admin UI so that
  /// CZoneMail.templateId keeps pointing at something — that link is what makes
  /// "purge every message sent from this template" possible after a bad template
  /// ships. See server/api/admin/czone-mail/templates/[id].delete.js.
  active    Boolean @default(true)

  /// All-time usage. Maintained by the notify worker, never on the send request
  /// path: the most popular template would otherwise be a single hot row that
  /// serializes every concurrent send behind a row lock.
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// One delivered message. `body`/`emoji` are snapshots taken at send time, so
/// editing a template never rewrites messages already sitting in inboxes.
model CZoneMail {
  id          String @id @default(uuid())
  senderId    String
  recipientId String

  /// Intentionally a plain column with no foreign key. The text is already
  /// denormalized below, so the relation bought nothing — and a SetNull FK makes
  /// every template delete an unindexed full-table UPDATE of this table.
  templateId String?

  body  String
  emoji String?

  readAt DateTime?
  /// Soft delete. A recipient deleting an upsetting message must not destroy the
  /// only evidence of it before an admin or parent can look.
  deletedAt DateTime?
  /// Set when the recipient hides a message from their public wall but keeps it
  /// in their inbox.
  hiddenFromWall DateTime?

  /// Set once the Discord notification covering this message has been sent (or
  /// deliberately skipped). The notify worker claims rows by this column, which
  /// is what makes notifications batch per recipient and survive a retry without
  /// double-pinging.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  sender    User @relation("CZoneMailSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("CZoneMailRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  /// Serves the inbox and the public wall (both filter on recipient, order by
  /// createdAt desc) and the FK check when a recipient is deleted.
  @@index([recipientId, createdAt])
  /// Spam forensics + the suspicious-activity view, and the sender-side FK check.
  @@index([senderId, createdAt])
  /// Retention prune scans this directly; `id` is a random UUID so there is no
  /// time correlation to exploit instead.
  @@index([createdAt])
  /// Admin "purge everything sent from this template" and the usage rollup.
  @@index([templateId])
  /// The notify worker's claim query: pending rows for one recipient.
  @@index([recipientId, notifiedAt])
  // NOTE: a partial index for the unread count —
  //   CREATE INDEX ... ON "CZoneMail"("recipientId") WHERE "readAt" IS NULL
  // — is created in the migration. Prisma's schema language cannot express it.
}

/// A player-level block. Named generically (not CZoneMailBlock) because the same
/// relation should eventually gate cZone chat and trade offers; today only cMail
/// enforces it.
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  // The unique already leads with blockerId, so it serves both the send-path
  // lookup and the "list who I've blocked" query. No extra index needed.
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Cache of the Discord thread used to notify one recipient. Treated as a cache,
/// not an identity: Discord can delete or archive threads out from under us, so
/// every row is recreated on error code 10003 (unknown channel).
model CZoneMailThread {
  userId    String  @id
  threadId  String  @unique
  /// The parent channel the thread was created under. If an admin repoints
  /// czoneMailDiscordChannelId, rows for the old channel are recreated.
  channelId String
  /// Set once the recipient has been added via PUT /thread-members, so the add
  /// is not repeated on every notification.
  memberAddedAt DateTime?
  lastPostedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

/// Recorded when a sender trips the burst guard. Surfaced on the admin
/// "Manage cZone Mail" page.
model CZoneMailSpamLog {
  id           String   @id @default(uuid())
  userId       String
  /// Sends counted in the window that tripped the guard.
  count        Int
  windowMinutes Int
  blockedUntil DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}
