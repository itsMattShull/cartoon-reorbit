  asteroidScamBulletSpeed      Float   @default(5.6)
  asteroidScamBulletLife       Int     @default(15)
  asteroidScamPellets          Int     @default(5)
  asteroidScamSpread           Int     @default(96)
  // C.A.S.U.A.L. — medium range, medium rate
  asteroidCasFireInterval      Int     @default(13)
  asteroidCasBulletSpeed       Float   @default(6.2)
  asteroidCasBulletLife        Int     @default(66)
  asteroidCasPellets           Int     @default(1)
  asteroidCasSpread            Int     @default(0)
  asteroidPointsLarge          Int     @default(20)
  asteroidPointsMedium         Int     @default(50)
  asteroidPointsSmall          Int     @default(100)
  asteroidWaveClearBonus       Int     @default(250)
  asteroidPowerupsEnabled      Boolean @default(true)
  asteroidPowerupBlueEnabled   Boolean @default(true)
  asteroidPowerupRedEnabled    Boolean @default(true)
  asteroidPowerupGreenEnabled  Boolean @default(true)
  asteroidPowerupIntervalTicks Int     @default(900)
  asteroidPowerupChancePercent Int     @default(65)
  asteroidPowerupBlueTicks     Int     @default(600)
  asteroidPowerupRedTicks      Int     @default(420)
  asteroidPowerupGreenTicks    Int     @default(720)

  // — Flappy Powerpuff settings —
  // World units, not pixels: the game runs in a fixed 480x760 world that is letterboxed into
  // whatever viewport the player has, so these values mean the same thing on every device.
  // Engine-side hard bounds live in CFG_BOUNDS in server/utils/flappyPowerpuffEngine.js.
  flappyPlaysPerPeriod     Int     @default(3)
  flappyPointsPerGame      Int     @default(50)
  flappyGravity            Float   @default(1500)
  flappyFlapVelocity       Float   @default(-440) // negative = upward
  flappyScrollSpeed        Float   @default(200)
  flappyPipeGap            Float   @default(215)
  flappyPipeSpacing        Float   @default(330)
  flappySpeedGrowthPerPipe Float   @default(0.02)
  flappyMaxSpeedMultiplier Float   @default(2)
  flappyMaxScore           Int     @default(500)
  flappyMaxSessionSeconds  Int     @default(900)
  flappyBlossomImagePath   String?
  flappyBubblesImagePath   String?
  flappyButtercupImagePath String?
  flappyCityImagePath      String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt
  // — ReOrbit Blackjack —
  // Every value here is clamped again by normalizeBlackjackConfig() in
  // server/utils/blackjackEngine.js, which is the source of truth for the bounds; the
  // validation table in server/api/admin/game-config.post.js mirrors them.
  blackjackDailyBuyInLimit  Int?     @default(300) // points a player may convert to chips per day
  blackjackDailyWinLimit    Int?     @default(900) // net winnings per day before an auto cash-out
  blackjackMinBet           Int?     @default(10)
  blackjackMaxBet           Int?     @default(100)
  blackjackPracticeStack    Int?     @default(1000) // free chips handed out in practice mode
  blackjackDeckCount        Int?     @default(6)
  // 3:2 as two integers, never a float — `bet * 1.5` on an odd bet mints or destroys half a
  // chip, and every other points value in this app is an Int.
  blackjackPayoutNum        Int?     @default(3)
  blackjackPayoutDen        Int?     @default(2)
  blackjackDealerHitsSoft17 Boolean? @default(false)
  blackjackAllowDouble      Boolean? @default(true)
  blackjackAllowSplit       Boolean? @default(true)
  blackjackAllowInsurance   Boolean? @default(true)

  // — Ed, Edd n Eddy RPS —
  // Bounds live in CONFIG_LIMITS in lib/edRps.js, which clampConfig() applies on every read,
  // so an out-of-range value saved here can never break a live match. `pointsPerWin` above is
  // shared with the other games and is what a natural PvP win pays.
  edRpsRoundSeconds        Int? @default(15) // per-round throw timer
  edRpsWinsNeeded          Int? @default(4) // round wins to take the match (best of 7)
  edRpsMaxRounds           Int? @default(7) // hard ceiling; ties replay and don't count
  edRpsPairDailyAwardLimit Int? @default(2) // point-paying wins one pair of players may trade per day
}

model GlobalGameConfig {
  id                             String  @id @default(uuid())
  dailyPointLimit                Int     @default(100)
  tkoDailyPointLimit             Int     @default(250)
  dailyLoginPoints               Int     @default(500)
  dailyNewUserPoints             Int     @default(1000)
  czoneVisitPoints               Int     @default(20)
  czoneVisitMaxPerDay            Int     @default(10)
  czoneCount                     Int     @default(3)
  phashDuplicateThreshold        Int     @default(14)
  dhashDuplicateThreshold        Int     @default(16)
  rarityDefaults                 Json?
  achievementDiscordChannelId    String?
  czoneContestDiscordChannelId   String?
  // ── cZone Mail ("cMail") settings ──
  // Edited on Admin > Global Settings > cZone Mail, via its own settings route
  // rather than global-config.post.js (which requires dailyPointLimit on every
  // POST and silently drops fields it doesn't destructure).
  /// Parent channel for per-recipient notification threads. Deliberately has no
  /// DISCORD_ANNOUNCEMENTS_CHANNEL fallback — unset means "DM only", never
  /// "post player mail into the announcements channel".
  czoneMailDiscordChannelId      String?
  czoneMailCooldownSeconds       Int     @default(30)
  czoneMailSpamWindowMinutes     Int     @default(6)
  czoneMailSpamThreshold         Int     @default(10)
  czoneMailSpamBlockHours        Int     @default(12)
  czoneMailRetentionDays         Int     @default(90)
  /// Minimum gap between messages from the same sender to the same recipient.
  /// The global cooldown alone cannot stop one player targeting one other player
  /// all day. 0 disables the rule.
  czoneMailPairCooldownMinutes   Int     @default(60)
  // Scavenger Hunt settings
  scavengerChancePercent         Int     @default(5) // 0–100; 0 disables
  scavengerCooldownHours         Int     @default(24) // cooldown between completed hunts per user
  // cToon release settings
  initialReleasePercent          Int     @default(75)
  finalReleaseDelayHours         Int     @default(12)
  featuredAuctionHours           Json    @default("[]") // int[] of hours 0–23 CST to fire
  featuredAuctionIntervalDays    Int     @default(1) // fire every N days
  featuredAuctionsPerSlot        Int     @default(1) // auctions created per slot
  featuredAuctionLastFiredSlot   String? // idempotency key e.g. "2026-03-30-08"
  cmartHalfPriceEnabled          Boolean @default(false) // halves cToon and pack prices in cMart
  // Pack price decay settings
  packPriceDecayAmount           Int     @default(100) // points to drop per decay period
  packPriceDecayDays             Int     @default(7) // days between each price drop
  packPriceFloor                 Int     @default(700) // minimum price after decay
  packMaxDefaultBuysPerUser      Int     @default(5) // default maxBuysPerUser set on new packs
  // Per-rarity time-based purchase limits: { "Common": { "count": 5, "windowDays": null }, ... }
  // windowDays null = full release window (releaseDate → mintEndDate)
  timeBasedPurchaseLimits        Json?
  // Second Edition overlay icon, shown over every Second Edition cToon's image
  secondEditionOverlayPath       String?
  secondEditionOverlayWidth      Int? // natural pixel width of the uploaded overlay image
  secondEditionOverlayHeight     Int? // natural pixel height of the uploaded overlay image
  // Game tile images shown on the Games page
  gameTileWinballImagePath       String?
  gameTileLottoImagePath         String?
  gameTileWinwheelImagePath      String?
  gameTileClashImagePath         String?
  gameTileTkoImagePath           String?
  gameTileReorbitmatchImagePath  String?
  gameTileTowerImagePath         String?
  gameTileReorbitmemoryImagePath String?
  gameTileGuessctoonImagePath    String?
  gameTileAsteroidImagePath      String?

  gameTileFlappyImagePath    String?
  gameTileBlackjackImagePath String?
  gameTileEdrpsImagePath     String?
  // Account-dissolve "featured auction" rules: cToons matching any of these
  // rarities/series/sets are marked isFeatured when an account is dissolved.
  // Each is a JSON array of strings, edited via the "Edit Featured" modal on
  // /admin/dissolve-queue.
  featuredDissolveRarities   Json     @default("[]")
  featuredDissolveSeries     Json     @default("[]")
  featuredDissolveSets       Json     @default("[]")
  // Site favicon / meta-icon set, uploaded from Admin > Manage Homepage > Favicon.
  // faviconVersion is bumped on every upload and appended as a cache-busting
  // query string to every icon URL rendered in pages/index.vue's useHead.
  faviconVersion             BigInt?
  faviconSourcePath          String? // original master upload, retained for re-generation/audit
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model WishlistItem {
  id            String   @id @default(uuid())
  userId        String
  ctoonId       String
  offeredPoints Int      @default(0) // NEW
  createdAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  ctoon Ctoon @relation(fields: [ctoonId], references: [id])

  @@unique([userId, ctoonId])
}

model UserTradeListItem {
  id          String   @id @default(uuid())
  userId      String
  userCtoonId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  userCtoon UserCtoon @relation(fields: [userCtoonId], references: [id])

  @@unique([userId, userCtoonId])
  @@index([userId])
  @@index([userCtoonId])
}

/// A pending trade between two users
model TradeOffer {
  id            String   @id @default(uuid())
  initiatorId   String // who is making the offer
  recipientId   String // who will receive the offer
  pointsOffered Int      @default(0)
  status        String   @default("PENDING") // e.g. PENDING, ACCEPTED, REJECTED, WITHDRAWN, COUNTERED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Set when this offer was created as a counter to another offer. The
  /// countered offer is closed out as COUNTERED in the same transaction that
  /// creates this one, so an offer can only ever be countered once — hence
  /// @unique, which lets the database enforce that rather than the app.
  counteredOfferId String? @unique

  initiator User @relation("OfferInitiator", fields: [initiatorId], references: [id])
  recipient User @relation("OfferRecipient", fields: [recipientId], references: [id])

  /// The earlier offer this one replaced.
  counteredOffer TradeOffer? @relation("TradeCounter", fields: [counteredOfferId], references: [id], onDelete: SetNull)

  /// The counter that replaced this offer, if any.
  counteredBy TradeOffer? @relation("TradeCounter")

  ctoons TradeOfferCtoon[]

  // incoming.get.js / outgoing.get.js filter on one party and sort by createdAt;
  // pending-trade lookups filter on status. Neither column was indexed.
  @@index([recipientId, status, createdAt])
  @@index([initiatorId, status, createdAt])
}

/// Join table tying a specific UserCtoon to a TradeOffer,
/// tagged as either OFFERED or REQUESTED
model TradeOfferCtoon {
  id           String              @id @default(uuid())
  tradeOfferId String
  userCtoonId  String
  role         TradeOfferCtoonRole

  tradeOffer TradeOffer @relation(fields: [tradeOfferId], references: [id])
  userCtoon  UserCtoon  @relation(fields: [userCtoonId], references: [id])

  @@unique([tradeOfferId, userCtoonId, role])
  // The "is this cToon already in a pending trade" guards, and every collection
  // load, filter on userCtoonId alone. The unique above leads with tradeOfferId
  // so it cannot serve those — they were sequential scans of the whole table.
  @@index([userCtoonId])
}

/// Are we offering this cToon, or requesting it?
enum TradeOfferCtoonRole {
  OFFERED
  REQUESTED
}

enum AuctionStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum GtoonTournamentStatus {
  DRAFT
  OPT_IN_OPEN
  OPT_IN_CLOSED
  SWISS_ACTIVE
  BRACKET_ACTIVE
  COMPLETE
  CANCELLED
}

enum GtoonTournamentStage {
  SWISS
  BRACKET
}

enum GtoonTournamentFormat {
  BRACKET_8_OR_LESS
  SWISS_THEN_TOP8
}

enum GtoonTournamentMatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  BYE
}

enum GtoonTournamentMatchOutcome {
  A_WIN
  B_WIN
  TIE
}

enum GtoonTournamentTiebreakMethod {
  NONE
  SUDDEN_DEATH
  ADMIN_SELECT
}

enum GtoonTournamentResolutionPolicy {
  FIRST_GAMES_AFTER_PAIRING
}

model Auction {
  id                 String        @id @default(uuid())
  userCtoonId        String
  initialBet         Int
  duration           Int // days
  endAt              DateTime
  status             AuctionStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  creatorId          String?
  highestBid         Int           @default(0)
  highestBidderId    String?
  winnerId           String?
  winnerAt           DateTime?
  endingSoonNotified Boolean       @default(false)
  isFeatured         Boolean       @default(false)
  // Back-reference to the AuctionOnly listing that activated into this Auction
  // (set at activation time in server/cron/sync-guild-members.js). Nullable/not a
  // FK since the AuctionOnly row can later be deleted while this Auction lives on.
  auctionOnlyId      String?       @unique

  userCtoon     UserCtoon @relation(fields: [userCtoonId], references: [id])
  creator       User?     @relation("AuctionsCreated", fields: [creatorId], references: [id])
  highestBidder User?     @relation("HighestBidder", fields: [highestBidderId], references: [id])
  winner        User?     @relation("AuctionWinner", fields: [winnerId], references: [id])

  bids     Bid[] // one-to-many on Bid
  autoBids AuctionAutoBid[]

  // NOTE: a partial unique index, "Auction_active_userCtoonId_key" ON
  // ("userCtoonId") WHERE status = 'ACTIVE', also exists on this table. It stops
  // the same cToon being auctioned twice at once, which otherwise lets both
  // auctions close and mint points against a single item. Partial indexes are
  // not expressible in the Prisma schema language, so it lives only in
  // migration 20260803000000_unique_active_auction_per_user_ctoon and shows up
  // as drift in `prisma migrate dev`. Do not drop it.
  @@index([userCtoonId, status])
  @@index([status, winnerId, highestBid])
  @@index([isFeatured, status, highestBidderId])
  // /api/my-auctions filters on creatorId and orders by endAt desc. Postgres
  // doesn't index foreign keys automatically, so without this the "My Auctions"
  // tab sequentially scans every auction ever created.
  @@index([creatorId, endAt])
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String
  userId    String
  amount    Int
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

// ── Economy page ─────────────────────────────────────────────────
// Daily per-cToon price/volume aggregates, one row per (ctoon, source, day).
// Populated by server/cron/economy-aggregate.js; read live by server/api/economy/*.
// AUCTION rows come straight from closed+won Auctions. TRADE rows use an
// "implied value" imputed from each accepted TradeOffer (see the cron job for
// the formula), since trades don't carry a native per-cToon price.
enum EconomySource {
  AUCTION
  TRADE
}

model CtoonPriceDaily {
  id       String        @id @default(uuid())
  ctoonId  String
  source   EconomySource
  date     DateTime // truncated to day (UTC)
  // NULL means "this activity happened but couldn't be priced" — a trade where
  // nothing involved had a known reference value. Volume is still recorded so
  // the Economy page's activity rankings aren't biased toward cToons that
  // already have auction/cMart pricing. Readers must exclude NULLs from
  // weighted averages (SUM(...) FILTER (WHERE "avgPrice" IS NOT NULL)).
  avgPrice Float?
  volume   Int // number of transactions this cToon appeared in that day

  ctoon Ctoon @relation(fields: [ctoonId], references: [id], onDelete: Cascade)

  @@unique([ctoonId, source, date])
  @@index([source, date, ctoonId])
  // Trending filters on date with no source predicate, so the index above can't
  // serve it (no btree skip-scan before PG18) and it seq-scans today.
  @@index([date, ctoonId, volume])
  // Makes the Browse "most traded/auctioned" all-time aggregate index-only and
  // pre-grouped by ctoonId.
  @@index([source, ctoonId, volume])
}

// Singleton cursor tracking how far server/cron/economy-aggregate.js has
// processed, so each run only rescans days touched since the last run
// instead of re-aggregating all-time history every time.
model EconomyAggregateCursor {
  id                     String   @id @default("singleton")
  lastAuctionProcessedAt DateTime @default("1970-01-01T00:00:00Z")
  lastTradeProcessedAt   DateTime @default("1970-01-01T00:00:00Z")
  updatedAt              DateTime @updatedAt
}

model ClashGame {
  id                  String  @id @default(uuid())
  player1UserId       String
  player2UserId       String? // null for AI
  player1Points       Int     @default(0) // staked by P1
  player2Points       Int     @default(0) // staked by P2
  player1DeckSnapshot Json?
  player2DeckSnapshot Json?
  isTournament        Boolean @default(false)

  winnerUserId  String? // null if AI won or tie
  outcome       String? // 'player' | 'ai' | 'tie' | 'incomplete'
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  whoLeftUserId String?

  whoLeft User? @relation("ClashGameWhoLeft", fields: [whoLeftUserId], references: [id])
  player1 User  @relation("ClashGamePlayer1", fields: [player1UserId], references: [id])
  player2 User? @relation("ClashGamePlayer2", fields: [player2UserId], references: [id])
  winner  User? @relation("ClashGameWinner", fields: [winnerUserId], references: [id])
}

// One completed Ed, Edd n Eddy RPS match.
//
// Written ONCE, at match end, inside the same transaction that awards the points — there is no
// stake to escrow, so unlike ClashGame there is nothing worth persisting mid-match. CPU
// practice matches are played entirely in the browser and never reach this table, which is why
// both player columns are NOT NULL.
//
// The IP/fingerprint/timing columns exist for one reason: win-trading between alts is the
// obvious way to farm a game this fast, and the admin cheat tooling is otherwise blind to game
// outcomes entirely. `pointsAwardedAt` doubles as the award idempotency key.
model EdRpsMatch {
  id     String @id @default(uuid())
  roomId String

  player1UserId    String
  player2UserId    String
  player1Character String
  player2Character String
  player1Score     Int    @default(0)
  player2Score     Int    @default(0)

  winnerUserId  String?
  whoLeftUserId String?
  // 'natural' | 'forfeit' | 'sweep' — only 'natural' ever pays points.
  endReason     String  @default("natural")

  // One entry per resolved round:
  // { n, p1, p2, p1Auto, p2Auto, p1Ms, p2Ms, w } where p1/p2 are hand indices, *Ms is the
  // server-measured response time, and w is 0 (tie) | 1 | 2. Kept terse on purpose: this is
  // read only by the admin log viewer, and a verbose shape costs GBs a year at this table's
  // write rate.
  rounds Json?

  // Collusion signals, captured at match start. IPs use the deterministic encryptIp() from
  // server/utils/ip-encrypt.js so they join directly against UserIP and DeviceFingerprintLog.
  player1Ip        String?
  player2Ip        String?
  player1VisitorId String?
  player2VisitorId String?
  sameIp           Boolean @default(false)
  sameVisitorId    Boolean @default(false)

  // Award accounting. pointsAwardedAt is claimed with a compare-and-set inside the award
  // transaction, so a forfeit racing a natural end can never pay twice.
  pointsAwarded   Int       @default(0)
  pointsAwardedAt DateTime?
  awardedUserId   String?
  // null when paid; otherwise why not:
  // 'forfeit' | 'abandoned' | 'pair_limit' | 'same_device' | 'cap_exhausted' | 'banned'
  suppressReason  String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  player1 User  @relation("EdRpsMatchPlayer1", fields: [player1UserId], references: [id])
  player2 User  @relation("EdRpsMatchPlayer2", fields: [player2UserId], references: [id])
  winner  User? @relation("EdRpsMatchWinner", fields: [winnerUserId], references: [id])
  whoLeft User? @relation("EdRpsMatchWhoLeft", fields: [whoLeftUserId], references: [id])

  // ClashGame has no indexes at all and its leaderboard sequentially scans five times over.
  // This table grows far faster, so it gets real ones. The migration adds partial variants
  // (WHERE "endedAt" IS NOT NULL) that Prisma cannot express.
  @@index([startedAt])
  @@index([endedAt])
  @@index([player1UserId, endedAt])
  @@index([player2UserId, endedAt])
  @@index([winnerUserId, endedAt])
}

model MonsterBattle {
  id                String                  @id @default(uuid())
  player1UserId     String
  player2UserId     String?
  player2IsAi       Boolean                 @default(false)
  player1MonsterId  String
  player2MonsterId  String?
