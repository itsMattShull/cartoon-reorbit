model WishlistItem {
  id            String   @id @default(uuid())
  userId        String
  ctoonId       String
  offeredPoints Int      @default(0) // NEW
  createdAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  ctoon Ctoon @relation(fields: [ctoonId], references: [id])

  @@unique([userId, ctoonId])
}

model UserTradeListItem {
  id          String   @id @default(uuid())
  userId      String
  userCtoonId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  userCtoon UserCtoon @relation(fields: [userCtoonId], references: [id])

  @@unique([userId, userCtoonId])
  @@index([userId])
  @@index([userCtoonId])
}

/// A pending trade between two users
model TradeOffer {
  id            String   @id @default(uuid())
  initiatorId   String // who is making the offer
  recipientId   String // who will receive the offer
  pointsOffered Int      @default(0)
  status        String   @default("PENDING") // e.g. PENDING, ACCEPTED, REJECTED, WITHDRAWN, COUNTERED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Set when this offer was created as a counter to another offer. The
  /// countered offer is closed out as COUNTERED in the same transaction that
  /// creates this one, so an offer can only ever be countered once — hence
  /// @unique, which lets the database enforce that rather than the app.
  counteredOfferId String? @unique

  initiator User @relation("OfferInitiator", fields: [initiatorId], references: [id])
  recipient User @relation("OfferRecipient", fields: [recipientId], references: [id])

  /// The earlier offer this one replaced.
  counteredOffer TradeOffer? @relation("TradeCounter", fields: [counteredOfferId], references: [id], onDelete: SetNull)

  /// The counter that replaced this offer, if any.
  counteredBy TradeOffer? @relation("TradeCounter")

  ctoons TradeOfferCtoon[]

  // incoming.get.js / outgoing.get.js filter on one party and sort by createdAt;
  // pending-trade lookups filter on status. Neither column was indexed.
  @@index([recipientId, status, createdAt])
  @@index([initiatorId, status, createdAt])
}

/// Join table tying a specific UserCtoon to a TradeOffer,
/// tagged as either OFFERED or REQUESTED
model TradeOfferCtoon {
  id           String              @id @default(uuid())
  tradeOfferId String
  userCtoonId  String
  role         TradeOfferCtoonRole

  tradeOffer TradeOffer @relation(fields: [tradeOfferId], references: [id])
  userCtoon  UserCtoon  @relation(fields: [userCtoonId], references: [id])

  @@unique([tradeOfferId, userCtoonId, role])
  // The "is this cToon already in a pending trade" guards, and every collection
  // load, filter on userCtoonId alone. The unique above leads with tradeOfferId
  // so it cannot serve those — they were sequential scans of the whole table.
  @@index([userCtoonId])
}

/// Are we offering this cToon, or requesting it?
enum TradeOfferCtoonRole {
  OFFERED
  REQUESTED
}

enum AuctionStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

