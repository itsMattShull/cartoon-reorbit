  user User      @relation(fields: [userId], references: [id])
  code ClaimCode @relation(fields: [codeId], references: [id])

  @@unique([userId, codeId])
}

model ClaimCodeReward {
  id                String @id @default(uuid())
  codeId            String
  points            Int?
  pooledUniqueCount Int?

