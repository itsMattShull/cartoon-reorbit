  asteroidPowerupBlueTicks     Int     @default(600)
  asteroidPowerupRedTicks      Int     @default(420)
  asteroidPowerupGreenTicks    Int     @default(720)

  // — Flappy Powerpuff settings —
  // World units, not pixels: the game runs in a fixed 480x760 world that is letterboxed into
  // whatever viewport the player has, so these values mean the same thing on every device.
  // Engine-side hard bounds live in CFG_BOUNDS in server/utils/flappyPowerpuffEngine.js.
  flappyPlaysPerPeriod     Int     @default(3)
  flappyPointsPerGame      Int     @default(50)
  flappyGravity            Float   @default(1500)
  flappyFlapVelocity       Float   @default(-440) // negative = upward
  flappyScrollSpeed        Float   @default(200)
  flappyPipeGap            Float   @default(215)
  flappyPipeSpacing        Float   @default(330)
  flappySpeedGrowthPerPipe Float   @default(0.02)
  flappyMaxSpeedMultiplier Float   @default(2)
  flappyMaxScore           Int     @default(500)
  flappyMaxSessionSeconds  Int     @default(900)
  flappyBlossomImagePath   String?
  flappyBubblesImagePath   String?
  flappyButtercupImagePath String?
  flappyCityImagePath      String?

  // — Fruit Samurai settings —
  // Every value here is clamped again by normalizeConfig() in lib/fruitSamuraiSim.js, which is
  // the source of truth for the bounds (CFG_BOUNDS); the validation table in
  // server/api/admin/game-config.post.js mirrors them. The engine re-clamps on the way OUT of
  // the Redis session too, because a session blob is no more trustworthy than the row it was
  // built from.
  //
  // Note what is absent: any slow-motion factor for the physics. The hourglass power-up is a
  // renderer pacing effect and never enters the simulation — see the note at the bottom of
  // lib/fruitSamuraiSim.js. `fruitSamuraiHourglassScalePercent` is read only by the client.
  fruitSamuraiRankedPlaysPerPeriod Int?    @default(3)
  fruitSamuraiPointsPerGame        Int?    @default(50)
  fruitSamuraiStartingLives        Int?    @default(3)
  fruitSamuraiGravity              Int?    @default(70)
  fruitSamuraiLaunchVyMin          Int?    @default(4000)
  fruitSamuraiLaunchVyMax          Int?    @default(4900)
  fruitSamuraiLaunchVxMax          Int?    @default(500)
  fruitSamuraiGraceTicks           Int?    @default(90)
  fruitSamuraiSpawnIntervalStart   Int?    @default(150)
  fruitSamuraiSpawnIntervalMin     Int?    @default(60)
  fruitSamuraiRampTicks            Int?    @default(9000)
  fruitSamuraiWaveTwoTicks         Int?    @default(2400)
  fruitSamuraiWaveThreeTicks       Int?    @default(6000)
  fruitSamuraiEscalationStart      Int?    @default(9000)
  fruitSamuraiEscalationTicks      Int?    @default(1500)
  fruitSamuraiSpeedStartPct        Int?    @default(100)
  fruitSamuraiSpeedMaxPct          Int?    @default(128)
  fruitSamuraiJitterTicks          Int?    @default(20)
  fruitSamuraiPowerupInterval      Int?    @default(900)
  fruitSamuraiPowerupChancePct     Int?    @default(55)
  fruitSamuraiWeightPiggy          Int?    @default(40)
  fruitSamuraiWeightHourglass      Int?    @default(35)
  fruitSamuraiWeightDynamite       Int?    @default(25)
  fruitSamuraiPowerupRadius        Int?    @default(22)
  fruitSamuraiPowerupSpeedPct      Int?    @default(85)
  fruitSamuraiPiggyMultiplier      Int?    @default(2)
  fruitSamuraiPiggyTicks           Int?    @default(480)
  fruitSamuraiHourglassScalePct    Int?    @default(45)
  fruitSamuraiHourglassTicks       Int?    @default(240)
  fruitSamuraiDynamiteFuseTicks    Int?    @default(36)
  fruitSamuraiDynamiteMultiplier   Int?    @default(3)
  fruitSamuraiDynamiteMaxTargets   Int?    @default(24)
  // Jack's in-character commentary. The line pool lives in the client; these only gate how
  // often it speaks, so there is no admin-authored text to store or render.
  fruitSamuraiJackChatterEnabled   Boolean @default(true)
  fruitSamuraiJackChatterCooldown  Int?    @default(420) // ticks between lines
  fruitSamuraiJackImagePath        String?
  fruitSamuraiBackgroundImagePath  String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt
  // — ReOrbit Blackjack —
  // Every value here is clamped again by normalizeBlackjackConfig() in
  // server/utils/blackjackEngine.js, which is the source of truth for the bounds; the
  // validation table in server/api/admin/game-config.post.js mirrors them.
  blackjackDailyBuyInLimit  Int?     @default(300) // points a player may convert to chips per day
  blackjackDailyWinLimit    Int?     @default(900) // net winnings per day before an auto cash-out
  blackjackMinBet           Int?     @default(10)
  blackjackMaxBet           Int?     @default(100)
  blackjackPracticeStack    Int?     @default(1000) // free chips handed out in practice mode
  blackjackDeckCount        Int?     @default(6)
  // 3:2 as two integers, never a float — `bet * 1.5` on an odd bet mints or destroys half a
  // chip, and every other points value in this app is an Int.
  blackjackPayoutNum        Int?     @default(3)
  blackjackPayoutDen        Int?     @default(2)
  blackjackDealerHitsSoft17 Boolean? @default(false)
  blackjackAllowDouble      Boolean? @default(true)
  blackjackAllowSplit       Boolean? @default(true)
  blackjackAllowInsurance   Boolean? @default(true)

  // — Ed, Edd n Eddy RPS —
  // Bounds live in CONFIG_LIMITS in lib/edRps.js, which clampConfig() applies on every read,
  // so an out-of-range value saved here can never break a live match. `pointsPerWin` above is
  // shared with the other games and is what a natural PvP win pays.
  edRpsRoundSeconds        Int? @default(15) // per-round throw timer
  edRpsWinsNeeded          Int? @default(4) // round wins to take the match (best of 7)
  edRpsMaxRounds           Int? @default(7) // hard ceiling; ties replay and don't count
  edRpsPairDailyAwardLimit Int? @default(2) // point-paying wins one pair of players may trade per day

  // — Pokemon: Fire, Water, Grass! —
  // Bounds live in CONFIG_LIMITS in lib/pokemonBattle.js, applied by clampConfig() on every
  // read. `pointsPerWin` above is shared with the other games. The per-pair daily limit is
  // enforced across ALL duel games (see server/utils/duelPairScope.js), so this value and the
  // edRps one describe the same shared budget from either side.
  pokemonBattleRoundSeconds        Int? @default(12) // shorter than RPS: the intermission is longer
  pokemonBattleWinsNeeded          Int? @default(3)
  pokemonBattleMaxRounds           Int? @default(9)
  pokemonBattlePairDailyAwardLimit Int? @default(2)

  // Master switch. Off hides the game from the Games page AND refuses to start a battle --
  // hiding the tile alone would leave the route playable by anyone with the URL, and PvP pays
  // points, so "not visible" has to mean "not earning" too.
  pokemonBattleEnabled Boolean? @default(true)

  // Uploaded art and music, as one JSON map of { slot: { path, width, height } } rather than
  // eleven more columns. GameConfig already carries 256 of them, several callers still do a
  // bare findUnique that ships every one, and art slots are the kind of thing that gets added
  // again next quarter. The allowlisted slot->column map that makes the upload endpoints safe
  // survives unchanged as an allowlisted slot->key map.
  //
  // Dimensions are stored alongside each path because the art is admin-supplied: the page
  // needs the real aspect ratio to reserve space, and hardcoding one guarantees layout shift.
  pokemonBattleAssets Json?
}

