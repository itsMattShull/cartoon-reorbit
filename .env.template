# DATABASE
DATABASE_URL="postgresql://orbit_user:SomeAmazingPassword@localhost:5432/orbitdb"

# JWT for session signing
JWT_SECRET="SomeReallCoolString123%"

# DISCORD OAUTH CONFIG
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# DISCORD GUILD GATE (YOUR SERVER)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_INVITE=https://discord.gg/InviteURLFromDiscordServer

# BOT TOKEN for real-time guild checks
BOT_TOKEN="Bot WhateverTokenFromDiscordDeveloperPortal"
# OPTIONAL: dedicated bot for scheduled + achievement announcements
DISCORD_ANNOUNCEMENTS_BOT_TOKEN="Bot WhateverTokenFromDiscordDeveloperPortal"
# OPTIONAL: fallback announcements channel ID, used when a feature-specific channel
# (e.g. achievements, cZone Contest) isn't set in the admin Global Settings page
DISCORD_ANNOUNCEMENTS_CHANNEL=

NUXT_PORT=3000
SOCKET_PORT=3001

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=           # if you set one in your redis.conf
MINT_QUEUE_KEY=mintQueue

SOCKET_ORIGIN = "http://localhost:3001"
SOCKET_PATH = "/socket.io"
# Comma-separated origins allowed to open a socket. The game clients connect with credentials
# so the session cookie reaches the handshake, and a browser refuses a wildcard on those.
# Defaults to the production and dev domains; localhost is allowed automatically outside
# production. Any other host the site is served from has to be listed here or its sockets
# will not connect.
SOCKET_ALLOWED_ORIGINS = "https://www.cartoonreorbit.com,https://cartoonreorbit.com,https://dev.cartoonreorbit.com"

OFFICIAL_USERNAME=QuirkyStormMercenary

PRISMA_POOL_SIZE=5
BARCODE_SECRET="1233saf"

# TKO Game integration
TKO_PASSCODE=

# Shared secret checked against the "Authorization: Bearer <secret>" header on
# POST /api/webhooks/github-pr. Must be a long random string (32+ chars) and must
# match the PR_WEBHOOK_SECRET set on this environment's GitHub Environment
# ("dev" or "production") used by .github/workflows/pr-discord-notify.yml.
# The endpoint refuses all requests if this is unset or too short.
GITHUB_PR_WEBHOOK_SECRET=
# owner/repo used to build the PR link in Discord PR notifications
GITHUB_REPO_SLUG=itsMattShull/cartoon-reorbit